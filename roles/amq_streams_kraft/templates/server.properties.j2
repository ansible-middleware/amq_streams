# --- KRaft Process Roles ---
# Defines if this node is a Broker, a Controller, or both.
process.roles={{ amq_streams_kraft_process_roles }}
node.id={{ amq_streams_kraft_node_id }}

# --- Controller Quorum ---
# The list of all voters (controllers) in the cluster. Format: id@host:port
controller.quorum.voters={{ amq_streams_kraft_controller_quorum_voters }}

# MUST contain BOTH Broker (PLAINTEXT) and Controller ports.
# Example: PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
listeners={{ amq_streams_kraft_listeners | join(',') }}

# MUST contain ONLY the Broker port.
# Example: PLAINTEXT://192.168.1.5:9092
advertised.listeners={{ amq_streams_kraft_advertised_listeners | join(',') }}

# Maps the listener names to security protocols.
listener.security.protocol.map={{ amq_streams_kraft_security_protocol_map | join(',') }}

# Tells the Controller which listener name to use for Raft communication.
controller.listener.names={{ amq_streams_kraft_controller_listener_names }}

# Tells the Broker which listener name to use for replication.
inter.broker.listener.name={{ amq_streams_kraft_inter_broker_listener_name }}

{% if amq_streams_kraft_auth_enabled %}
# The list of SASL mechanisms enabled in the Kafka server
sasl.enabled.mechanisms={{ amq_streams_kraft_auth_sasl_mechanisms | join(",") }}
{% if amq_streams_kraft_inter_broker_auth_sasl_mechanisms is defined %}
# SASL mechanism used for inter-broker communication
sasl.mechanism.inter.broker.protocol={{ amq_streams_kraft_inter_broker_auth_sasl_mechanisms }}
{% endif %}
{% endif %}

{% if amq_streams_kraft_tls_enabled %}
# Broker Keystore and Truststore files
ssl.keystore.location={{ amq_streams_kraft_tls_keystore_location }}/{{ amq_streams_kraft_tls_keystore }}
ssl.keystore.password={{ amq_streams_kraft_tls_keystore_password }}
ssl.truststore.location={{ amq_streams_kraft_tls_truststore_location }}/{{ amq_streams_kraft_tls_truststore }}
ssl.truststore.password={{ amq_streams_kraft_tls_truststore_password }}
{% if amq_streams_kraft_auth_enabled %}
ssl.client.auth=required
{% else %}
ssl.client.auth=none
{% endif %}
{% endif %}

# Logs
log.dirs={{ amq_streams_kraft_log_dirs }}
log.retention.hours={{ amq_streams_kraft_log_retention_hours }}
